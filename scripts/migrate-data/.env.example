# Copy to .env and fill in real values. Never commit .env.

# The OLD app's database — same connection details as legacy/conn.php
# (host localhost, user root, empty password, db movie_ticket_booking) unless
# you've moved it. Use 127.0.0.1 instead of localhost if you hit the
# Docker/socket gotcha documented in legacy/PROJECT_REFERENCE.md §6.
LEGACY_DATABASE_URL="mysql://root:@127.0.0.1:3306/movie_ticket_booking"

# The NEW database — same value as server/.env's DATABASE_URL. Run
# `npm run prisma:migrate --workspace=server` (schema created) and
# `npm run seed --workspace=server` (super-admin bootstrapped) against this
# database BEFORE running this script.
DATABASE_URL="mysql://root:@127.0.0.1:3306/mycinezone"
