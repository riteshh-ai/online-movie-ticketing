# Copy to .env and fill in real values. Never commit .env.

# MySQL connection used by Prisma. Points at the SAME database engine as the
# legacy app (see legacy/PROJECT_REFERENCE.md §6) so the data migration in
# scripts/migrate-data/ is a same-engine copy, not a cross-engine conversion.
DATABASE_URL="mysql://root:@127.0.0.1:3306/mycinezone"

PORT=4000
NODE_ENV=development

# Origin(s) allowed to call the API with credentials (the React SPA dev server).
CLIENT_ORIGIN="http://localhost:5173"

# Secrets for signing auth tokens — generate real random values, do not reuse
# across environments. e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# One-time bootstrap super-admin, used only by prisma/seed to create the first
# admin_users row. Replaces the hardcoded admin@gmail.com/admin1234 check in
# legacy/Admin/index.php — see migration.md "Auth & authorization".
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="change-me-before-seeding"

# eSewa test credentials — simulate-only flow, carried over from
# legacy/esewa_config.php. Not wired to a live gateway. See migration.md
# "Payments".
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_GATEWAY_URL="https://uat.esewa.com.np/api/epay/main/v2/form"
